{
  "import": {
    "importDirectories": [
      "/media/<username1>",
      "/media/<username2>"
    ],
    "externalHardDiskIdentifier": ".exclude_this_drive",
    "rootDirectory": "data/spool/import",
    "fileTypes": [
      {
        "extension": ".jpg",
        "dateRename": true,
        "keepOriginalFilename": true
      },
      {
        "extension": ".jpeg",
        "dateRename": true,
        "keepOriginalFilename": true
      },
      {
        "extension": ".png",
        "dateRename": true,
        "keepOriginalFilename": true
      },
      {
        "extension": ".nef",
        "dateRename": true,
        "keepOriginalFilename": true
      },
      {
        "extension": ".nrw",
        "dateRename": true,
        "keepOriginalFilename": true
      },
      {
        "extension": ".mp4",
        "dateRename": true,
        "keepOriginalFilename": false
      },
      {
        "extension": ".mov",
        "dateRename": true,
        "keepOriginalFilename": false
      },
      {
        "extension": ".gpx",
        "dateRename": true,
        "keepOriginalFilename": false
      }
    ]
  },
  "external": [
    {
      "root": "data/spool/external/drive1",
      "physicalPaths": ["data/storage/drive1", "data/storage/ssd1"],
      "active": true
    },
    {
      "root": "data/spool/external/drive2",
      "physicalPaths": ["data/storage/hdd2", "data/storage/ssd2"],
      "active": true
    }
  ],
  "remote": [
    {
      "root": "data/spool/remote/host1",
      "username": "username",
      "pubKeyPath": "host1.pem",
      "host": "127.0.0.1",
      "port": 22,
      "directory": "files",
      "active": false
    }
  ]
}